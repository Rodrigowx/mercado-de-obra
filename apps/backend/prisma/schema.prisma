datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String
  password              String
  name                  String
  phoneNumber           String
  role                  String
  emailVerified         Boolean                @default(false)
  professional          Professional?
  client                Client?
  passwordResetCode     PasswordResetCode?     @relation("UserPasswordResetCode")
  emailVerificationCode EmailVerificationCode? @relation("EmailVerification")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  chatIds               String[]               @default([])

  @@unique([email, role])
}

model Professional {
  id           Int         @id
  user         User        @relation(fields: [id], references: [id], onDelete: Cascade)
  profileImage String?
  skills       Int[]
  portfolios   Portfolio[]
  location     Location?
  availability String?
  reviews      Review[]
  rating       Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  budgets Budget[]
  Need    Need[]

  @@index([id])
}

model Client {
  id        Int      @id
  user      User     @relation(fields: [id], references: [id], onDelete: Cascade)
  reviews   Review[]
  needs     Need[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  budgets   Budget[]

  @@index([id])
}

model Service {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  icon            String
  professionalIds Int[]           @default([])
  BudgetService   BudgetService[]
}

model Portfolio {
  id             Int          @id @default(autoincrement())
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      Int
  title          String
  description    String
  images         Image[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@index([professionalId])
  @@index([serviceId])
}

model Image {
  id          Int       @id @default(autoincrement())
  url         String
  portfolioId Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId])
}

model Location {
  id             Int           @id @default(autoincrement())
  professionalId Int           @unique
  latitude       Float
  longitude      Float
  city           String
  state          String
  country        String
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())

  @@index([professionalId])
}

model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  user      User     @relation("UserPasswordResetCode", fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique
  code      String
  expiresAt DateTime
  validated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model EmailVerificationCode {
  userId    Int      @id
  code      String
  expiresAt DateTime
  user      User     @relation("EmailVerification", fields: [userId], references: [id])
}

model Review {
  id             Int           @id @default(autoincrement())
  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId Int
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  punctuality    Int
  quality        Int
  organization   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())

  @@index([clientId])
  @@index([professionalId])
}

model Budget {
  id                      Int             @id @default(autoincrement())
  needId                  Int
  need                    Need            @relation(fields: [needId], references: [id])
  clientId                Int
  client                  Client          @relation(fields: [clientId], references: [id])
  professionalId          Int
  professional            Professional?   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amount                  Float?
  description             String?
  status                  String          @default("PENDING")
  laborCost               Float?
  materialList            String[]
  materialCost            Float?
  totalCost               Float?
  recommendedInstallments Int?
  serviceDetails          String?
  plannedStartDate        String?
  plannedEndDate          String?
  paymentDates            String[]
  paymentFrequency        String?
  initialPaymentDate      String?
  obraTitle               String?
  obraAddress             String?
  obraRules               String[]
  precisaAjudante         Boolean?        @default(false)
  valorDiariaAjudante     Float?
  qtdAjudantes            Int?
  valorAlimentacao        Float?
  valorTransporte         Float?
  margemLucro             Float?
  budgetServices          BudgetService[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now())

  @@index([needId])
  @@index([clientId])
  @@index([professionalId])
}

model Need {
  id             Int          @id @default(autoincrement())
  title          String
  description    String
  clientId       Int
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  chatId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  serviceId      Int
  budgetId       Int?
  budgets        Budget[]

  @@index([clientId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([budgetId])
}

model UnitOfMeasurement {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  description    String
  budgetServices BudgetService[]
}

model BudgetService {
  id                  Int                @id @default(autoincrement())
  budgetId            Int
  budget              Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  unitOfMeasurementId Int
  unitOfMeasurement   UnitOfMeasurement? @relation(fields: [unitOfMeasurementId], references: [id], onDelete: Cascade)
  task                String
  quantity            Float
  needsMaterials      Boolean?           @default(false)
  materialsJson       Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now())
  Service             Service?           @relation(fields: [serviceId], references: [id])
  serviceId           Int?
  serviceValue        Float?

  @@index([budgetId])
  @@index([unitOfMeasurementId])
  @@index([serviceId])
}
